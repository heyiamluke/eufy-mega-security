# Use a dedicated Eufy guest account. Do not put real values in this file.
EUFY_USERNAME=
EUFY_PASSWORD=
EUFY_COUNTRY=AU

# Only needed for the first login if Eufy requests a verification code.
EUFY_VERIFY_CODE=

# Defaults are safe for local development.
EUFY_GATEWAY_HOST=127.0.0.1
EUFY_GATEWAY_PORT=3218
EUFY_GATEWAY_DATA_DIR=./data
EUFY_GATEWAY_PROVIDER=eufy
EUFY_GATEWAY_STREAM_GRACE_SECONDS=10
EUFY_GATEWAY_MAX_STREAM_SECONDS=120

# Required before binding the gateway beyond loopback. Use a long random value.
EUFY_GATEWAY_API_TOKEN=
