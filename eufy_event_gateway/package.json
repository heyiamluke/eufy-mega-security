{
  "name": "eufy-ha-gateway",
  "version": "0.1.18",
  "private": true,
  "description": "Event-first Eufy camera gateway for Home Assistant",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run typecheck && npm run test:shell && npm test",
    "release:check": "node scripts/check-release-consistency.mjs",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "poc:ppcs": "tsx scripts/ppcs-probe.ts",
    "test": "node --import tsx --test 'test/**/*.test.ts'",
    "test:shell": "sh -n run.sh",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@eneris/push-receiver": "^4.3.1",
    "werift": "^0.24.4",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
